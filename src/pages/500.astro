---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Erro Interno (500) — Conversor de Vídeo';
const pageDescription = 'Ocorreu um erro temporário ao carregar a página. Tente recarregar ou voltar para a página inicial.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-20 text-center space-y-6">
    <div class="w-16 h-16 mx-auto rounded-3xl bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-900 text-red-600 dark:text-red-400 flex items-center justify-center font-mono font-bold text-xl">
      500
    </div>
    
    <div class="space-y-2">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        Erro Temporário
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-md mx-auto leading-relaxed">
        Não foi possível concluir sua requisição no momento. Por favor, tente recarregar a página.
      </p>
    </div>

    <div class="pt-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-zinc-900 dark:bg-zinc-100 hover:bg-zinc-800 dark:hover:bg-white text-white dark:text-zinc-900 font-bold text-sm shadow-xs transition-all active:scale-95 cursor-pointer"
      >
        <span>Voltar para a Página Inicial</span>
      </a>
    </div>
  </div>
</BaseLayout>
