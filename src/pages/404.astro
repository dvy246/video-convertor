---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Página Não Encontrada (404) — Conversor de Vídeo';
const pageDescription = 'A página que você procura não foi encontrada. Acesse o ConversordeVideo.com para converter seus arquivos de vídeo e áudio.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-20 text-center space-y-6">
    <div class="w-16 h-16 mx-auto rounded-3xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-500 dark:text-zinc-400 font-mono font-bold text-xl">
      404
    </div>
    
    <div class="space-y-2">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        Página Não Encontrada
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-md mx-auto leading-relaxed">
        O endereço que você tentou acessar não existe ou foi movido. Utilize um dos links abaixo para continuar.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-xs transition-all active:scale-95 cursor-pointer"
      >
        <span>Ir para o Conversor Principal</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5">
          <path strokeLinecap="round" strokeLinejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href="/converter-mov-para-mp4"
        class="px-4 py-3 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold text-sm transition-all"
      >
        Converter MOV para MP4
      </a>
      
      <a
        href="/converter-video-para-mp3"
        class="px-4 py-3 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold text-sm transition-all"
      >
        Extrair Áudio MP3
      </a>
    </div>
  </div>
</BaseLayout>
