---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Página Não Encontrada (404) / Page Not Found — Conversor de Vídeo';
const pageDescription = 'A página que você procura não foi encontrada / The requested page was not found.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-20 text-center space-y-6">
    <div class="w-16 h-16 mx-auto rounded-3xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-500 dark:text-zinc-400 font-mono font-bold text-xl">
      404
    </div>
    
    <div class="space-y-2">
      <h1 id="error-title" class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        Página Não Encontrada / Page Not Found
      </h1>
      <p id="error-desc" class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-md mx-auto leading-relaxed">
        O endereço que você tentou acessar não existe ou foi movido. / The page you were looking for doesn’t exist or has been moved.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
      <a
        id="home-btn"
        href="/"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-xs transition-all active:scale-95 cursor-pointer"
      >
        <span id="home-text">Ir para o Conversor Principal / Go to Home</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5">
          <path strokeLinecap="round" strokeLinejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        id="mov-btn"
        href="/converter-mov-para-mp4"
        class="px-4 py-3 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold text-sm transition-all"
      >
        MOV &rarr; MP4
      </a>
      
      <a
        id="mp3-btn"
        href="/converter-video-para-mp3"
        class="px-4 py-3 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold text-sm transition-all"
      >
        Video &rarr; MP3
      </a>
    </div>
  </div>

  <script is:inline>
    // Detect language from URL path
    const path = window.location.pathname;
    const match = path.match(/^\/([a-z]{2})\//);
    const lang = match ? match[1] : 'pt';

    const homeBtn = document.getElementById('home-btn');
    const movBtn = document.getElementById('mov-btn');
    const mp3Btn = document.getElementById('mp3-btn');

    if (lang !== 'pt') {
      if (homeBtn) homeBtn.setAttribute('href', '/' + lang + '/');
      if (movBtn) movBtn.setAttribute('href', '/' + lang + '/converter-mov-para-mp4');
      if (mp3Btn) mp3Btn.setAttribute('href', '/' + lang + '/converter-video-para-mp3');
    }
  </script>
</BaseLayout>
