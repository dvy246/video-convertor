---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ConverterApp } from '../components/converter/ConverterApp';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Features from '../components/sections/Features.astro';
import ComparisonTable from '../components/sections/ComparisonTable.astro';
import HomeSEOArticle from '../components/sections/HomeSEOArticle.astro';
import FormatGrid from '../components/sections/FormatGrid.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import { 
  generateWebApplicationSchema, 
  generateHowToSchema, 
  generateFAQSchema,
  generateOrganizationSchema,
  generateWebSiteSchema
} from '../lib/seo/schema';

const pageTitle = 'Conversor de Vídeo Online Grátis — Sem Upload, Privado e Seguro';
const pageDescription = 'Conversor de vídeo online gratuito no navegador. Converta, comprima, extraia áudio e crie GIFs de vídeos sem upload e sem cadastro. Rápido e privado.';
const canonicalUrl = 'https://conversordevideo.com';

const faqs = [
  {
    question: 'O conversor de vídeo é realmente gratuito?',
    answer: 'Sim! Você pode converter quantos vídeos quiser, sem limites diários, sem cadastro, sem marcas d’água e sem taxas ocultas.'
  },
  {
    question: 'Meus vídeos particulares são enviados para algum servidor na internet?',
    answer: 'Não. Nosso conversor utiliza a tecnologia WebAssembly (FFmpeg WASM), processando todo o arquivo diretamente na memória do seu próprio navegador (celular ou computador). Seus vídeos nunca saem do seu aparelho.'
  },
  {
    question: 'Como compactar vídeo para enviar no WhatsApp sem estourar 16MB?',
    answer: 'Basta selecionar seu vídeo e escolher a predefinição "Otimizado para WhatsApp" no conversor. Nossa ferramenta calcula a taxa de bits ideal para compactar o vídeo abaixo de 16 MB em resolução 720p HD, garantindo envio direto sem compressão destrutiva do aplicativo.'
  },
  {
    question: 'Quais formatos de vídeo posso converter?',
    answer: 'Aceitamos arquivos nos formatos MP4, MOV (iPhone), AVI, MKV, WebM, WMV, FLV, M4V, 3GP, M2TS, MTS, VOB, TS, MXF e outros. Você pode exportar para MP4, MP3 (áudio), GIF animado, WebM, MOV, AVI ou MKV.'
  },
  {
    question: 'Como converter vídeo em áudio ou extrair áudio MP3 de uma gravação?',
    answer: 'Com certeza! Para converter vídeo em áudio, selecione o formato de saída "MP3" ou a predefinição "Extrair Áudio". Nosso conversor isola a trilha sonora e codifica o som no padrão MP3 de 192 kbps estéreo em alta fidelidade.'
  },
  {
    question: 'Existe limite máximo de tamanho de arquivo?',
    answer: 'Não impomos limites artificiais. Como o processamento usa a memória RAM do seu aparelho, arquivos de até 300MB a 500MB funcionam perfeitamente na maioria dos celulares e computadores modernos.'
  }
];

const orgSchema = generateOrganizationSchema();
const siteSchema = generateWebSiteSchema('pt', pageDescription);

const webAppSchema = generateWebApplicationSchema({
  name: 'Conversor de Vídeo Online',
  description: pageDescription,
  url: canonicalUrl,
  lang: 'pt'
});

const howToSchema = generateHowToSchema({
  name: 'Como converter vídeos gratuitamente no navegador',
  description: 'Passo a passo rápido para converter qualquer formato de vídeo de forma privada sem upload.',
  steps: [
    {
      position: 1,
      name: 'Selecione seu arquivo de vídeo',
      text: 'Arraste o arquivo para a área de conversão ou clique para selecionar do seu dispositivo.'
    },
    {
      position: 2,
      name: 'Escolha o formato e a predefinição',
      text: 'Selecione o formato desejado (MP4, MP3, GIF, etc.) e a otimização recomendada.'
    },
    {
      position: 3,
      name: 'Converta e baixe o vídeo',
      text: 'Clique em Converter Agora e baixe o arquivo processado diretamente para seu dispositivo.'
    }
  ]
});

const faqSchema = generateFAQSchema(faqs);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  schemas={[orgSchema, siteSchema, webAppSchema, howToSchema, faqSchema]}
>
  <!-- Hero & Converter Section -->
  <section class="pt-8 pb-12 sm:pt-14 sm:pb-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center space-y-4 mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 text-xs font-bold uppercase tracking-wider border border-emerald-200/80 dark:border-emerald-800/60">
        ✨ A Nova Geração de Conversores Web
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-zinc-900 dark:text-white tracking-tight leading-tight">
        Conversor de Vídeo <span class="relative inline-block whitespace-nowrap"><span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-teal-500 to-emerald-600 dark:from-emerald-400 dark:via-teal-300 dark:to-emerald-400 drop-shadow-2xs">Online</span><svg class="absolute -bottom-1 sm:-bottom-2 left-0 w-full h-2 sm:h-2.5 text-emerald-500 dark:text-emerald-400 opacity-80 pointer-events-none select-none overflow-visible" viewBox="0 0 100 8" fill="none" preserveAspectRatio="none" aria-hidden="true"><path d="M0 6C30 1 70 1 100 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg></span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        Converta seus vídeos diretamente no navegador. <strong>Sem upload</strong> para servidores, <strong>sem cadastro</strong> e <strong>sem limites diários</strong>. Rápido, seguro e gratuito.
      </p>
    </div>

    <!-- Interactive Converter App Island -->
    <ConverterApp client:idle />
  </section>

  <!-- How It Works Section -->
  <HowItWorks />

  <!-- Features Section -->
  <Features />

  <!-- Comparison Section -->
  <ComparisonTable />

  <!-- In-Depth 600+ Word SEO Article Section -->
  <HomeSEOArticle />

  <!-- Format Grid / Specialized Tools -->
  <FormatGrid />

  <!-- FAQ Section -->
  <FAQSection faqs={faqs} />
</BaseLayout>
