---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { nonDefaultLangs, type SupportedLanguage } from '../../i18n/languages';
import { TERMS_PAGES } from '../../data/legalPages';
import { generateBreadcrumbSchema } from '../../lib/seo/schema';
import { useTranslatedPath, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const data = TERMS_PAGES[lang] || TERMS_PAGES.en;
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

const canonicalUrl = `https://conversordevideo.com${translatePath('/termos')}`;

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: t('footer.infoTitle'), url: `https://conversordevideo.com${translatePath('/')}` },
  { name: data.title, url: canonicalUrl }
]);

const termsPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': data.title,
  'description': data.metaDescription,
  'url': canonicalUrl,
  'inLanguage': lang
};
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  canonicalUrl={canonicalUrl}
  lang={lang}
  schemas={[termsPageSchema, breadcrumbSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-10 text-zinc-700 dark:text-zinc-300">
    <div class="space-y-3">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 rounded-full border border-emerald-100 dark:border-emerald-900/60">
        {data.badge}
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        {data.title}
      </h1>
      <p class="text-xs text-zinc-500 dark:text-zinc-400">{data.updatedDate}</p>
    </div>

    <article class="prose prose-zinc dark:prose-invert max-w-none space-y-6 text-sm sm:text-base leading-relaxed">
      {data.sections.map((sec) => (
        <section class="space-y-2">
          <h2 class="text-xl font-bold text-zinc-900 dark:text-white">{sec.title}</h2>
          {sec.paragraphs.map((p) => (
            <p class="text-zinc-600 dark:text-zinc-300">{p}</p>
          ))}
          {sec.listItems && sec.listItems.length > 0 && (
            <ul class="list-disc pl-5 space-y-1 text-zinc-600 dark:text-zinc-300">
              {sec.listItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </section>
      ))}

      <section class="space-y-2 pt-4 border-t border-zinc-200 dark:border-zinc-800">
        <p class="text-zinc-600 dark:text-zinc-300">{data.contactText}</p>
      </section>
    </article>
  </div>
</BaseLayout>
