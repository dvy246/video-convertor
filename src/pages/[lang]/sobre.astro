---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { nonDefaultLangs, type SupportedLanguage } from '../../i18n/languages';
import { ABOUT_PAGES } from '../../data/legalPages';
import { generateBreadcrumbSchema } from '../../lib/seo/schema';
import { useTranslatedPath, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const data = ABOUT_PAGES[lang] || ABOUT_PAGES.en;
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

const canonicalUrl = `https://conversordevideo.com${translatePath('/sobre')}`;

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: t('footer.infoTitle'), url: `https://conversordevideo.com${translatePath('/')}` },
  { name: data.title, url: canonicalUrl }
]);

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'name': data.title,
  'description': data.metaDescription,
  'url': canonicalUrl,
  'inLanguage': lang,
  'mainEntity': {
    '@type': 'Organization',
    'name': 'Conversor de Vídeo',
    'alternateName': 'ConversordeVideo.com',
    'url': 'https://conversordevideo.com',
    'email': 'suporte@conversordevideo.com',
    'contactPoint': {
      '@type': 'ContactPoint',
      'contactType': 'customer support',
      'email': 'suporte@conversordevideo.com',
      'url': `https://conversordevideo.com${translatePath('/sobre')}`
    }
  }
};
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  canonicalUrl={canonicalUrl}
  lang={lang}
  schemas={[aboutPageSchema, breadcrumbSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-12 text-zinc-700 dark:text-zinc-300">
    <div class="space-y-3">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 rounded-full border border-emerald-100 dark:border-emerald-900/60">
        {data.badge}
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        {data.title}
      </h1>
      <p class="text-xs text-zinc-500 dark:text-zinc-400">{data.updatedDate}</p>
    </div>

    <div class="space-y-8 text-sm sm:text-base leading-relaxed">
      {data.sections.map((sec) => (
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white">{sec.title}</h2>
          {sec.paragraphs.map((p) => (
            <p class="text-zinc-600 dark:text-zinc-300">{p}</p>
          ))}
          {sec.listItems && sec.listItems.length > 0 && (
            <ul class="list-disc pl-5 space-y-2 text-zinc-600 dark:text-zinc-300">
              {sec.listItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </div>
      ))}

      <div class="p-6 bg-emerald-50/70 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 rounded-2xl space-y-2">
        <p class="text-xs sm:text-sm text-emerald-900 dark:text-emerald-300 leading-relaxed font-medium">
          {data.contactText}
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
