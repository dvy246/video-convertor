---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolsDirectory from '../../components/tools/ToolsDirectory.astro';
import { getLocalizedDirectoryTools } from '../../data/allToolsData';
import { useTranslations } from '../../i18n/utils';
import { nonDefaultLangs, type SupportedLanguage } from '../../i18n/languages';
import { generateBreadcrumbSchema, generateWebApplicationSchema, generateFAQSchema } from '../../lib/seo/schema';

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props as { lang: SupportedLanguage };
const t = useTranslations(lang);
const tools = getLocalizedDirectoryTools(lang);
const canonicalUrl = `https://conversordevideo.com/${lang}/ferramentas`;

const localizedTitles: Record<SupportedLanguage, string> = {
  pt: 'Todas as Ferramentas',
  en: 'All Tools',
  es: 'Todas las Herramientas',
  fr: 'Tous les Outils',
  ja: '全ツール一覧',
  zh: '全部工具',
  no: 'Alle Verktøy',
  tr: 'Tüm Araçlar',
  pl: 'Wszystkie Narzędzia'
};

const homeTitles: Record<SupportedLanguage, string> = {
  pt: 'Início',
  en: 'Home',
  es: 'Inicio',
  fr: 'Accueil',
  ja: 'ホーム',
  zh: '首页',
  no: 'Hjem',
  tr: 'Ana Sayfa',
  pl: 'Strona Główna'
};

const faqSectionTitles: Record<SupportedLanguage, { title: string; subtitle: string }> = {
  pt: { title: 'Perguntas Frequentes sobre as Ferramentas', subtitle: 'Tudo o que você precisa saber sobre privacidade, compatibilidade e velocidade.' },
  en: { title: 'Frequently Asked Questions', subtitle: 'Everything you need to know about privacy, performance, and compatibility.' },
  es: { title: 'Preguntas Frecuentes', subtitle: 'Todo lo que necesitas saber sobre privacidad, compatibilidad y velocidad.' },
  fr: { title: 'Foire Aux Questions', subtitle: 'Tout ce que vous devez savoir sur la confidentialité et la vitesse.' },
  ja: { title: 'よくある質問 (FAQ)', subtitle: 'プライバシー保護、動作速度、対応形式についてのご案内。' },
  zh: { title: '常见问题解答 (FAQ)', subtitle: '了解关于浏览器本地运算、隐私安全及兼容性的详细说明。' },
  no: { title: 'Ofte Stilte Spørsmål', subtitle: 'Alt du trenger å vite om personvern, ytelse og kompatibilitet.' },
  tr: { title: 'Sıkça Sorulan Sorular', subtitle: 'Gizlilik, performans ve uyumluluk hakkında bilmeniz gereken her şey.' },
  pl: { title: 'Najczęściej Zadawane Pytania', subtitle: 'Wszystko o prywatności, kompatybilności i szybkości działania.' }
};

const localizedFaqs: Record<SupportedLanguage, { q: string; a: string }[]> = {
  pt: [
    { q: 'As ferramentas deste catálogo exigem upload de arquivos?', a: 'Não. Todas as 51 ferramentas realizam o processamento no seu navegador através de WebAssembly (FFmpeg.wasm). Nenhum byte do seu vídeo ou áudio é enviado para servidores externos.' },
    { q: 'Existe limite diário de uso ou tamanho de arquivo?', a: 'Não há limite de conversões diárias. Você pode converter e comprimir quantos arquivos precisar, sem assinaturas ou cobranças ocultas.' },
    { q: 'Posso usar as ferramentas no celular (Android e iPhone)?', a: 'Sim! Nossas ferramentas são totalmente compatíveis com smartphones (Chrome no Android, Safari no iOS), tablets e computadores.' },
    { q: 'Qual é a qualidade de áudio ao extrair para MP3?', a: 'A extração para áudio MP3 utiliza taxa de amostragem constante de 192 kbps com codificação LAME de alta fidelidade.' }
  ],
  en: [
    { q: 'Do these tools upload files to remote servers?', a: 'No. All 51 tools run locally in your browser using WebAssembly (FFmpeg.wasm). Your files are processed entirely in device memory and never leave your machine.' },
    { q: 'Is there a daily limit or file size paywall?', a: 'There are no usage limits or paywalls. You can convert, compress, and resize as many media files as you need, completely free.' },
    { q: 'Can I use these tools on mobile devices (iPhone & Android)?', a: 'Yes! All tools are fully responsive and work seamlessly on mobile browsers including Safari for iOS and Chrome for Android.' },
    { q: 'What audio quality is extracted for MP3s?', a: 'MP3 extraction uses high-fidelity 192 kbps constant bitrate encoding powered by the official LAME engine.' }
  ],
  es: [
    { q: '¿Estas herramientas suben archivos a servidores?', a: 'No. Las 51 herramientas funcionan en tu navegador mediante WebAssembly (FFmpeg.wasm). Ningún dato sale de tu dispositivo.' },
    { q: '¿Hay límite de uso diario o costos ocultos?', a: 'No hay límites de archivos ni suscripciones. Puedes convertir y comprimir todos los archivos que desees sin restricciones.' },
    { q: '¿Puedo usar las herramientas en mi móvil?', a: '¡Sí! Es totalmente compatible con Chrome en Android y Safari en iPhone/iPad sin necesidad de instalar apps.' },
    { q: '¿Qué calidad tiene el audio MP3 extraído?', a: 'La extracción a MP3 ofrece una tasa de bits de 192 kbps de alta fidelidad.' }
  ],
  fr: [
    { q: 'Ces outils nécessitent-ils l’envoi de fichiers sur un serveur ?', a: 'Non. Les 51 outils fonctionnent localement dans votre navigateur via WebAssembly. Vos fichiers restent confidentiels sur votre appareil.' },
    { q: 'Y a-t-il une limite quotidienne de conversion ?', a: 'Aucune limite ni abonnement. Vous pouvez convertir et compresser autant de fichiers que nécessaire, gratuitement.' },
    { q: 'Puis-je utiliser ces outils sur smartphone ?', a: 'Oui, nos outils fonctionnent parfaitement sur Safari iOS (iPhone) et Chrome Android sans aucune application supplémentaire.' },
    { q: 'Quelle est la qualité de l’audio MP3 extrait ?', a: 'L’extraction audio utilise un débit constant de 192 kbps haute fidélité.' }
  ],
  ja: [
    { q: 'ファイルはサーバーにアップロードされますか？', a: 'いいえ。全51種類のツールはWebAssemblyにより端末のブラウザ内（メモリ上）でローカル処理されます。外部サーバーへの送信は一切ありません。' },
    { q: '1日の利用制限や容量課金はありますか？', a: '制限や課金は一切ありません。何度でも完全無料で動画の変換や圧縮をご利用いただけます。' },
    { q: 'スマホ（iPhoneやAndroid）でも利用できますか？', a: 'はい！iOS SafariやAndroid Chromeなどのスマホブラウザでも快適に動作します。' },
    { q: 'MP3抽出時の音質はどのくらいですか？', a: '高音質な192 kbpsの一定ビットレート（CBR）でクリアな音声を抽出します。' }
  ],
  zh: [
    { q: '这些工具需要上传文件到远程服务器吗？', a: '绝不需要。全部 51 款工具均基于 WebAssembly（FFmpeg.wasm）在您的浏览器内存中本地运行，文件 留存在本地，绝无云端上传。' },
    { q: '有每日使用次数限制或隐藏收费吗？', a: '完全没有。无任何付费门槛或文件数量限制，随时随地免费使用。' },
    { q: '可以在手机（iPhone / 安卓）上使用吗？', a: '可以！完全适配移动端，支持 iOS Safari 和安卓 Chrome 浏览器，免安装 App。' },
    { q: '提取为 MP3 音频的音质如何？', a: '采用 192 kbps 高保真恒定比特率进行无损级音轨剥离。' }
  ],
  no: [
    { q: 'Laster disse verktøyene opp filene mine til en server?', a: 'Nei. Alle 51 verktøy kjører lokalt i nettleseren din via WebAssembly. Ingen filer sendes ut.' },
    { q: 'Er det noen daglige begrensninger eller betalingsmurer?', a: 'Ingen begrensninger eller abonnement. Konverter og komprimer så mye du vil helt gratis.' },
    { q: 'Kan jeg bruke verktøyene på mobil (iPhone og Android)?', a: 'Ja, verktøyene er fullt tilpasset Safari på iOS og Chrome på Android.' },
    { q: 'Hvilken lydkvalitet får jeg ved MP3-uttrekk?', a: 'Lyduttrekk kodes i 192 kbps konstant bithastighet med høy presisjon.' }
  ],
  tr: [
    { q: 'Bu araçlar dosyaları sunucuya yüklüyor mu?', a: 'Hayır. 51 aracın tümü WebAssembly ile tarayıcınızda %100 yerel olarak çalışır. Dosyalarınız cihazınızdan asla ayrılmaz.' },
    { q: 'Günlük kullanım sınırı veya ücret var mı?', a: 'Hiçbir sınır veya gizli ücret yoktur. İstediğiniz kadar dosyayı tamamen ücretsiz dönüştürebilirsiniz.' },
    { q: 'Telefonda (iPhone ve Android) kullanabilir miyim?', a: 'Evet! Mobil tarayıcılarla (iOS Safari, Android Chrome) tam uyumludur.' },
    { q: 'MP3 ses kalitesi nasıldır?', a: 'MP3 ses çıkarma işlemi 192 kbps yüksek kaliteli sabit bit hızında gerçekleşir.' }
  ],
  pl: [
    { q: 'Czy te narzędzia wysyłają pliki na serwer?', a: 'Nie. Wszystkie 51 narzędzi działa lokalnie w przeglądarce za pomocą WebAssembly. Twoje pliki są w pełni bezpieczne.' },
    { q: 'Czy istnieje dzienny limit konwersji?', a: 'Nie ma żadnych limitów ani płatności. Korzystaj z narzędzi bez ograniczeń za darmo.' },
    { q: 'Czy mogę korzystać z narzędzi na telefonie?', a: 'Tak! Narzędzia działają bezproblemowo w Safari na iOS i Chrome na Androidzie.' },
    { q: 'Jaka jest jakość wyodrębnionego dźwięku MP3?', a: 'Dźwięk MP3 jest zapisywany ze stałą przepływnością 192 kbps wysokiej jakości.' }
  ]
};

const faqs = localizedFaqs[lang] || localizedFaqs.en;
const faqSec = faqSectionTitles[lang] || faqSectionTitles.en;

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: homeTitles[lang] || 'Home', url: `https://conversordevideo.com/${lang}` },
  { name: localizedTitles[lang] || 'All Tools', url: canonicalUrl }
]);

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': t('tools.metaTitle'),
  'description': t('tools.metaDesc'),
  'url': canonicalUrl,
  'inLanguage': lang,
  'mainEntity': {
    '@type': 'ItemList',
    'numberOfItems': tools.length,
    'itemListElement': tools.map((tool, index) => ({
      '@type': 'ListItem',
      'position': index + 1,
      'name': tool.title,
      'url': `https://conversordevideo.com${tool.href}`
    }))
  }
};

const faqSchema = generateFAQSchema(faqs);
const webAppSchema = generateWebApplicationSchema({
  name: t('tools.metaTitle'),
  description: t('tools.metaDesc'),
  url: canonicalUrl,
  lang: lang
});

const labels = {
  searchPlaceholder: t('tools.searchPlaceholder'),
  filterAll: t('tools.filterAll'),
  filterVideo: t('tools.filterVideo'),
  filterCompress: t('tools.filterCompress'),
  filterAudio: t('tools.filterAudio'),
  filterResize: t('tools.filterResize'),
  filterGif: t('tools.filterGif'),
  filterDevices: t('tools.filterDevices'),
  countShowing: t('tools.countShowing'),
  countOf: t('tools.countOf'),
  countTools: t('tools.countTools'),
  emptyTitle: t('tools.emptyTitle'),
  emptyDesc: t('tools.emptyDesc'),
  clearFilters: t('tools.clearFilters'),
  openTool: t('tools.openTool'),
  statSpeed: t('tools.statSpeed'),
  statPrivacy: t('tools.statPrivacy'),
  statFree: t('tools.statFree')
};
---

<BaseLayout
  title={t('tools.metaTitle')}
  description={t('tools.metaDesc')}
  canonicalUrl={canonicalUrl}
  lang={lang}
  schemas={[collectionSchema, breadcrumbSchema, webAppSchema, faqSchema]}
>
  <!-- Hero Section -->
  <div class="relative overflow-hidden pt-12 pb-6 sm:pt-16 sm:pb-10 border-b border-zinc-200/60 dark:border-zinc-800/80 bg-gradient-to-b from-emerald-50/40 via-white to-transparent dark:from-emerald-950/20 dark:via-zinc-950 dark:to-transparent">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-4">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100/80 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 text-xs font-bold border border-emerald-200 dark:border-emerald-800/60 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{t('tools.heroBadge')}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-zinc-900 dark:text-white tracking-tight leading-tight">
        {t('tools.heroTitlePrefix')}{' '}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-500">
          {t('tools.heroTitleHighlight')}
        </span>{' '}
        {t('tools.heroTitleSuffix')}
      </h1>

      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 max-w-3xl mx-auto leading-relaxed">
        {t('tools.heroSubtitle')}
      </p>

    </div>
  </div>

  <!-- Interactive Directory Island -->
  <ToolsDirectory tools={tools} lang={lang} labels={labels} />

  <!-- Educational & FAQ Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 space-y-12 border-t border-zinc-200/80 dark:border-zinc-800">
    <div class="text-center space-y-3">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        {faqSec.title}
      </h2>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
        {faqSec.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {faqs.map((faq) => (
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xs space-y-2">
          <h3 class="text-sm sm:text-base font-bold text-zinc-900 dark:text-white">
            {faq.q}
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {faq.a}
          </p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
