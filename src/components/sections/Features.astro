---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/languages';

export interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const features = [
  {
    title: t('features.privacyTitle'),
    description: t('features.privacyDesc'),
    icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z'
  },
  {
    title: t('features.freeTitle'),
    description: t('features.freeDesc'),
    icon: 'M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z'
  },
  {
    title: t('features.smartCompressTitle'),
    description: t('features.smartCompressDesc'),
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z'
  },
  {
    title: t('features.speedTitle'),
    description: t('features.speedDesc'),
    icon: 'M13 10V3L4 14h7v7l9-11h-7z'
  },
  {
    title: t('features.audioExtractTitle'),
    description: t('features.audioExtractDesc'),
    icon: 'M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3'
  },
  {
    title: t('features.formatsTitle'),
    description: t('features.formatsDesc'),
    icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z'
  }
];
---

<section class="py-12 sm:py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-10">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 rounded-full border border-emerald-100 dark:border-emerald-900/60">
        {t('features.badge')}
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        {t('features.title')}
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
        {t('features.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <div class="group relative bg-white/95 dark:bg-zinc-900/95 backdrop-blur-sm border border-zinc-200/80 dark:border-zinc-800/80 hover:border-emerald-500/70 dark:hover:border-emerald-500/70 rounded-2xl p-6 sm:p-7 space-y-3.5 shadow-xs hover:shadow-2xl hover:shadow-emerald-500/10 dark:hover:shadow-emerald-500/10 hover:-translate-y-1.5 hover:scale-[1.012] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden before:absolute before:inset-x-0 before:top-0 before:h-[1.5px] before:bg-gradient-to-r before:from-transparent before:via-emerald-400/60 before:to-transparent before:opacity-0 group-hover:before:opacity-100 before:transition-opacity before:duration-300">
          {/* Ambient subtle light glow */}
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />

          <div class="relative z-10 w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-950/80 dark:to-teal-950/80 text-emerald-600 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-900/60 shadow-xs flex items-center justify-center group-hover:scale-110 group-hover:-translate-y-0.5 group-hover:rotate-[-2deg] group-hover:border-emerald-300 dark:group-hover:border-emerald-700 group-hover:shadow-md group-hover:shadow-emerald-500/20 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
            <svg class="w-5.5 h-5.5 text-emerald-600 dark:text-emerald-400 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" d={feature.icon} />
            </svg>
          </div>
          <h3 class="relative z-10 text-base sm:text-lg font-bold text-zinc-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors duration-200">
            {feature.title}
          </h3>
          <p class="relative z-10 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
