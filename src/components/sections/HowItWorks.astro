---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/languages';

export interface Props {
  title?: string;
  subtitle?: string;
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const {
  title = t('howItWorks.title'),
  subtitle = t('howItWorks.subtitle')
} = Astro.props;

const steps = [
  {
    number: '01',
    title: t('howItWorks.step1Title'),
    description: t('howItWorks.step1Desc')
  },
  {
    number: '02',
    title: t('howItWorks.step2Title'),
    description: t('howItWorks.step2Desc')
  },
  {
    number: '03',
    title: t('howItWorks.step3Title'),
    description: t('howItWorks.step3Desc')
  }
];
---

<section class="py-12 sm:py-16 bg-white dark:bg-zinc-900 border-y border-zinc-200/80 dark:border-zinc-800 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-10">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 rounded-full border border-emerald-100 dark:border-emerald-900/60">
        {t('howItWorks.badge')}
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        {title}
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {steps.map((step) => (
        <div class="group relative bg-white/95 dark:bg-zinc-900/95 backdrop-blur-sm border border-zinc-200/80 dark:border-zinc-800/80 hover:border-emerald-500/70 dark:hover:border-emerald-500/70 rounded-2xl p-6 sm:p-7 space-y-3.5 shadow-xs hover:shadow-2xl hover:shadow-emerald-500/10 dark:hover:shadow-emerald-500/10 hover:-translate-y-1.5 hover:scale-[1.012] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden before:absolute before:inset-x-0 before:top-0 before:h-[1.5px] before:bg-gradient-to-r before:from-transparent before:via-emerald-400/60 before:to-transparent before:opacity-0 group-hover:before:opacity-100 before:transition-opacity before:duration-300">
          {/* Ambient subtle light glow */}
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />

          <div class="relative z-10 flex items-center justify-between">
            <span class="font-mono text-2xl sm:text-3xl font-black text-emerald-600/80 dark:text-emerald-400/80 group-hover:scale-110 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-all duration-300">
              {step.number}
            </span>
            <div class="w-8 h-8 rounded-full bg-emerald-100/60 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 flex items-center justify-center font-bold text-xs group-hover:scale-110 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-300">
              ✓
            </div>
          </div>
          <h3 class="relative z-10 text-base sm:text-lg font-bold text-zinc-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors duration-200">
            {step.title}
          </h3>
          <p class="relative z-10 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>

    {/* Visual Local Processing Workflow Demo Card (E-E-A-T Experience Signal) */}
    <div class="mt-8 rounded-2xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200/80 dark:border-zinc-800/80 p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 overflow-hidden relative">
      <div class="space-y-2 max-w-lg">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-100/70 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          WebAssembly RAM Transcoding
        </div>
        <h4 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-white">
          Fluxo de Conversão no Seu Dispositivo
        </h4>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          O arquivo é carregado diretamente no buffer de memória do navegador. O motor FFmpeg WASM codifica os quadros em tempo real sem qualquer conexão com servidores externos.
        </p>
      </div>

      <div class="flex items-center gap-2 sm:gap-4 shrink-0 font-mono text-xs font-medium text-zinc-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 p-3 sm:p-4 rounded-xl shadow-xs">
        <div class="flex flex-col items-center gap-1">
          <span class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-bold">MOV / MP4</span>
          <span class="text-[10px] text-zinc-400">Origem</span>
        </div>
        <span class="text-emerald-500 font-bold text-base">➔</span>
        <div class="flex flex-col items-center gap-1">
          <span class="px-2.5 py-1 rounded bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 font-bold border border-emerald-200/60 dark:border-emerald-800/60">WASM RAM</span>
          <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">0ms Fila</span>
        </div>
        <span class="text-emerald-500 font-bold text-base">➔</span>
        <div class="flex flex-col items-center gap-1">
          <span class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-bold">MP4 / MP3</span>
          <span class="text-[10px] text-zinc-400">Download</span>
        </div>
      </div>
    </div>
  </div>
</section>
