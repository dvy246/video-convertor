<section class="py-12 sm:py-16 bg-zinc-50 dark:bg-zinc-900/50 border-y border-zinc-200/80 dark:border-zinc-800 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-10">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 rounded-full border border-emerald-100 dark:border-emerald-900/60">
        Comparativo Transparente
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        ConversordeVideo.com vs. Conversores Antigos
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
        Veja por que processar vídeos localmente no navegador é muito superior ao modelo antigo de servidores na nuvem.
      </p>
    </div>

    <!-- Responsive Comparison Table -->
    <div class="overflow-x-auto rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-xs">
      <table class="w-full text-left text-xs sm:text-sm border-collapse">
        <thead>
          <tr class="bg-zinc-100/70 dark:bg-zinc-800/80 border-b border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-200 font-bold">
            <th class="p-4 sm:p-5">Recurso / Critério</th>
            <th class="p-4 sm:p-5 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-950 dark:text-emerald-300 border-x border-emerald-200/80 dark:border-emerald-800/60">
              <div class="flex items-center gap-1.5 font-extrabold text-sm sm:text-base">
                <span>ConversordeVideo.com</span>
                <span class="text-[10px] bg-emerald-600 text-white px-2 py-0.5 rounded-full uppercase tracking-wider">Novo</span>
              </div>
            </th>
            <th class="p-4 sm:p-5">Convertio</th>
            <th class="p-4 sm:p-5">CloudConvert</th>
            <th class="p-4 sm:p-5">FreeConvert</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-200/80 dark:divide-zinc-800 text-zinc-700 dark:text-zinc-300">
          <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/50">
            <td class="p-4 font-semibold text-zinc-900 dark:text-white">Privacidade dos Arquivos</td>
            <td class="p-4 bg-emerald-50/40 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-300 font-bold border-x border-emerald-100 dark:border-emerald-800/40">
              <span class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5"><path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" /></svg>
                100% Local (Zero Upload)
              </span>
            </td>
            <td class="p-4 text-zinc-500 dark:text-zinc-400">Upload p/ Nuvem</td>
            <td class="p-4 text-zinc-500 dark:text-zinc-400">Upload p/ Nuvem</td>
            <td class="p-4 text-zinc-500 dark:text-zinc-400">Upload p/ Nuvem</td>
          </tr>

          <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/50">
