                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5"><path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" /></svg>
                Livre (Usa RAM do dispositivo)
              </span>
            </td>
            <td class="p-4 text-red-600 dark:text-red-400 font-medium">Apenas 100 MB</td>
            <td class="p-4 text-zinc-600 dark:text-zinc-300">Até 1 GB (com fila)</td>
            <td class="p-4 text-zinc-600 dark:text-zinc-300">Até 1 GB (com fila)</td>
          </tr>

          <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/50">
            <td class="p-4 font-semibold text-zinc-900 dark:text-white">Cota Diária de Conversão</td>
            <td class="p-4 bg-emerald-50/40 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-300 font-bold border-x border-emerald-100 dark:border-emerald-800/40">
              <span class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5"><path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" /></svg>
                Ilimitada
