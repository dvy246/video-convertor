            <td class="p-4 text-zinc-400 dark:text-zinc-500">Não disponível</td>
            <td class="p-4 text-zinc-400 dark:text-zinc-500">Não disponível</td>
            <td class="p-4 text-zinc-400 dark:text-zinc-500">Não disponível</td>
