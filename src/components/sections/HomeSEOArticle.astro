---
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';
import { getLocalizedHomeArticle } from '../../data/homeArticles';
import type { SupportedLanguage } from '../../i18n/languages';

export interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);
const article = getLocalizedHomeArticle(currentLang);
---

<section class="py-12 sm:py-16 bg-white dark:bg-zinc-900 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-10 text-zinc-700 dark:text-zinc-300">
    <div class="space-y-3">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 rounded-full border border-emerald-100 dark:border-emerald-900/60">
        {article.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        {article.title}
      </h2>
      <p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
        {article.subtitle}
      </p>
    </div>

    <!-- Article Content -->
    <article class="prose prose-zinc dark:prose-invert max-w-none space-y-8 text-sm sm:text-base leading-relaxed">
      
      <!-- Section 1 -->
      <div class="space-y-3">
        <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">
          {article.sec1Title}
        </h3>
        <p class="text-zinc-600 dark:text-zinc-300">
          {article.sec1P1}
        </p>
        <p class="text-zinc-600 dark:text-zinc-300">
          {article.sec1P2}
        </p>
        <p class="text-zinc-600 dark:text-zinc-300">
          {article.sec1P3}
        </p>
        <div class="p-4 bg-emerald-50/70 dark:bg-emerald-950/40 border-l-4 border-emerald-500 rounded-r-xl text-emerald-950 dark:text-emerald-300 text-xs sm:text-sm font-medium">
          {article.sec1Callout}
        </div>
      </div>

      <!-- Section 2 -->
      <div class="space-y-3">
        <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">
          {article.sec2Title}
        </h3>
        <p class="text-zinc-600 dark:text-zinc-300">
          {article.sec2P1}
        </p>
        <ul class="list-disc pl-5 space-y-2 text-zinc-600 dark:text-zinc-300">
          <li>{article.sec2L1}</li>
          <li>{article.sec2L2}</li>
          <li>{article.sec2L3}</li>
        </ul>
        <p class="text-zinc-600 dark:text-zinc-300">
          {article.sec2P2}
        </p>
      </div>

      <!-- Section 3 -->
      <div class="space-y-3">
        <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">
          {article.sec3Title}
        </h3>
        <p class="text-zinc-600 dark:text-zinc-300">
          {article.sec3P1}
        </p>
        <ol class="list-decimal pl-5 space-y-2 text-zinc-600 dark:text-zinc-300">
          <li>{article.sec3L1}</li>
          <li>{article.sec3L2}</li>
        </ol>
        <p class="text-zinc-600 dark:text-zinc-300">
          {article.sec3P2}
        </p>
      </div>

      <!-- Section 4 -->
      <div class="space-y-3">
        <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">
          {article.sec4Title}
        </h3>
        <p class="text-zinc-600 dark:text-zinc-300">
          {article.sec4P1}
        </p>
        <p class="text-zinc-600 dark:text-zinc-300">
          {article.sec4P2}
        </p>
      </div>

      <!-- Section 5 -->
      <div class="space-y-3">
        <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">
          {article.sec5Title}
        </h3>
        <p class="text-zinc-600 dark:text-zinc-300">
          {article.sec5P1}
        </p>
        <ul class="list-disc pl-5 space-y-2 text-zinc-600 dark:text-zinc-300">
          <li>{article.sec5L1}</li>
          <li>{article.sec5L2}</li>
        </ul>
      </div>

      <!-- Section 6: Dedicated Tool Hubs & Internal Links -->
      {article.sec6Title && (
        <div class="space-y-4 pt-4 border-t border-zinc-100 dark:border-zinc-800/80">
          <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">
            {article.sec6Title}
          </h3>
          <p class="text-zinc-600 dark:text-zinc-300">
            {article.sec6P1}
          </p>
          <ul class="list-disc pl-5 space-y-3 text-zinc-600 dark:text-zinc-300">
            <li>
              <a href={translatePath('/compressor-de-video')} class="font-semibold text-emerald-600 dark:text-emerald-400 hover:underline">
                {article.sec6L1Title}
              </a>: {article.sec6L1Desc}
            </li>
            <li>
              <a href={translatePath('/converter-video-em-audio')} class="font-semibold text-emerald-600 dark:text-emerald-400 hover:underline">
                {article.sec6L2Title}
              </a>: {article.sec6L2Desc}
            </li>
            <li>
              <a href={translatePath('/compactar-video-para-whatsapp')} class="font-semibold text-emerald-600 dark:text-emerald-400 hover:underline">
                {article.sec6L3Title}
              </a>: {article.sec6L3Desc}
            </li>
            <li>
              <a href={translatePath('/redimensionar-video')} class="font-semibold text-emerald-600 dark:text-emerald-400 hover:underline">
                {article.sec6L4Title}
              </a>: {article.sec6L4Desc}
            </li>
            <li>
              <a href={translatePath('/video-para-gif')} class="font-semibold text-emerald-600 dark:text-emerald-400 hover:underline">
                {article.sec6L5Title}
              </a>: {article.sec6L5Desc}
            </li>
          </ul>
        </div>
      )}

    </article>
  </div>
</section>
