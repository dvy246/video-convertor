---

<section class="py-12 sm:py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-10">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 rounded-full border border-emerald-100 dark:border-emerald-900/60">
        Todas as Ferramentas
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        Conversores de Formato Especializados
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
        Escolha a página específica para o seu formato com configurações pré-ajustadas e velocidade máxima.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {tools.map((tool) => (
        <a
          href={translatePath(tool.href)}
          class="group bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 hover:border-emerald-500/70 dark:hover:border-emerald-500/70 rounded-2xl p-5 sm:p-6 space-y-3 transition-all hover:shadow-xs flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="w-10 h-10 rounded-xl bg-zinc-50 dark:bg-zinc-800 group-hover:bg-emerald-50 dark:group-hover:bg-emerald-950/80 text-zinc-700 dark:text-zinc-300 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 border border-zinc-100 dark:border-zinc-700/80 flex items-center justify-center transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                  <path strokeLinecap="round" strokeLinejoin="round" d={tool.icon} />
                </svg>
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 group-hover:bg-emerald-100 dark:group-hover:bg-emerald-950/80 text-zinc-600 dark:text-zinc-300 group-hover:text-emerald-800 dark:group-hover:text-emerald-300 transition-colors">
                {tool.badge}
              </span>
            </div>
            <h3 class="text-base font-bold text-zinc-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">
              {tool.title}
            </h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
              {tool.description}
            </p>
          </div>
          
          <div class="pt-2 flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform">
            <span>Acessar</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
