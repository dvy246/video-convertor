---
import ThemeSlider from './ThemeSlider.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import PaletteSwitcher from './PaletteSwitcher.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { 
  getLocalizedPopularTools, 
  getLocalizedCompressorTools, 
  getLocalizedCamcorderTools 
} from '../../i18n/navTools';
import type { SupportedLanguage } from '../../i18n/languages';

export interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

const popularTools = getLocalizedPopularTools(currentLang);
const compressorAndSocialTools = getLocalizedCompressorTools(currentLang);
const camcorderAndClassicTools = getLocalizedCamcorderTools(currentLang);
---

<div class="sticky top-2.5 sm:top-3.5 z-50 w-full px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto transition-all duration-300">
  <header class="w-full bg-white/85 dark:bg-zinc-900/85 backdrop-blur-xl border border-zinc-200/90 dark:border-zinc-800/90 rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.06)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.35)] transition-all duration-200 px-3 sm:px-4 md:px-5 lg:px-6 h-14 sm:h-16 flex items-center justify-between gap-2 sm:gap-4 lg:gap-3 xl:gap-6">
    
    <!-- 1. Logo & Brand Identity (Left) -->
    <a href={translatePath('/')} class="flex items-center gap-2 sm:gap-2.5 group shrink-0 select-none py-1 pl-0.5" aria-label="Conversor de Vídeo — Home">
      <div class="w-8 h-8 sm:w-8.5 sm:h-8.5 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex items-center justify-center shadow-xs shadow-emerald-500/25 ring-1 ring-emerald-500/20 transition-all duration-200 group-hover:scale-105 shrink-0">
        <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      </div>
      <div class="flex items-center whitespace-nowrap">
        <span class="font-bold text-sm sm:text-base tracking-tight text-zinc-900 dark:text-white leading-none group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
          Conversor<span class="text-emerald-600 dark:text-emerald-400">deVídeo</span>
        </span>
      </div>
    </a>

    <!-- 2. Desktop Navigation (Center - Perfectly Centered, Non-Wrapping Pill Items) -->
    <nav class="hidden lg:flex items-center justify-center gap-1 xl:gap-2 2xl:gap-4 flex-1 text-sm font-medium text-zinc-600 dark:text-zinc-400 whitespace-nowrap" aria-label="Main Navigation">
      
      <!-- Mega Menu: Formatos & Ferramentas -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1.5 px-2.5 xl:px-3 py-1.5 rounded-full text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100/90 dark:hover:bg-zinc-800/70 transition-all cursor-pointer whitespace-nowrap"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span class="whitespace-nowrap">{t('header.formats')}</span>
          <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200/80 dark:border-zinc-700/80 leading-none">
            36
          </span>
          <svg class="w-3 h-3 text-zinc-400 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-transform duration-200 group-hover:rotate-180 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Mega Menu Panel -->
        <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-1 w-[720px] pointer-events-none group-hover:pointer-events-auto z-50">
          <div class="bg-white/95 dark:bg-zinc-900/95 backdrop-blur-2xl border border-zinc-200/90 dark:border-zinc-800 rounded-3xl p-5 shadow-2xl shadow-zinc-950/15 grid grid-cols-3 gap-5 text-left">
            
            <!-- Column 1: Popular & Audio -->
            <div class="space-y-2">
              <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 flex items-center gap-1.5 px-1">
                <span>⚡</span>
                <span>{t('header.colPopular')}</span>
              </div>
              <ul class="space-y-0.5">
                {popularTools.map((tItem) => (
                  <li>
                    <a href={translatePath(tItem.href)} class="block p-2 rounded-xl hover:bg-zinc-100/80 dark:hover:bg-zinc-800/80 transition-colors group/item">
                      <div class="text-xs font-semibold text-zinc-800 dark:text-zinc-200 group-hover/item:text-emerald-600 dark:group-hover/item:text-emerald-400 transition-colors">
                        {tItem.name}
                      </div>
                      <div class="text-[11px] text-zinc-400 dark:text-zinc-500 leading-tight truncate mt-0.5">
                        {tItem.desc}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Column 2: Compressors & Social -->
            <div class="space-y-2">
              <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 flex items-center gap-1.5 px-1">
                <span>🗜️</span>
                <span>{t('header.colCompress')}</span>
              </div>
              <ul class="space-y-0.5">
                {compressorAndSocialTools.map((tItem) => (
                  <li>
                    <a href={translatePath(tItem.href)} class="block p-2 rounded-xl hover:bg-zinc-100/80 dark:hover:bg-zinc-800/80 transition-colors group/item">
                      <div class="text-xs font-semibold text-zinc-800 dark:text-zinc-200 group-hover/item:text-emerald-600 dark:group-hover/item:text-emerald-400 transition-colors">
                        {tItem.name}
                      </div>
                      <div class="text-[11px] text-zinc-400 dark:text-zinc-500 leading-tight truncate mt-0.5">
                        {tItem.desc}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Column 3: Camcorders & Classic -->
            <div class="space-y-2">
              <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 flex items-center gap-1.5 px-1">
                <span>📹</span>
                <span>{t('header.colCamcorders')}</span>
              </div>
              <ul class="space-y-0.5">
                {camcorderAndClassicTools.slice(0, 5).map((tItem) => (
                  <li>
                    <a href={translatePath(tItem.href)} class="block p-2 rounded-xl hover:bg-zinc-100/80 dark:hover:bg-zinc-800/80 transition-colors group/item">
                      <div class="text-xs font-semibold text-zinc-800 dark:text-zinc-200 group-hover/item:text-emerald-600 dark:group-hover/item:text-emerald-400 transition-colors">
                        {tItem.name}
                      </div>
                      <div class="text-[11px] text-zinc-400 dark:text-zinc-500 leading-tight truncate mt-0.5">
                        {tItem.desc}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Bottom Row: View All 36 Tools -->
            <div class="col-span-3 pt-3 mt-1 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between">
              <span class="text-xs text-zinc-400 dark:text-zinc-500 font-medium flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                {t('header.badge')}
              </span>
              <a href={translatePath('/ferramentas')} class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:underline">
                <span>{t('header.allFormats')}</span>
              </a>
            </div>

          </div>
        </div>
      </div>

      <!-- Quick Nav Links (Pill-Styled, Single-Line) -->
      <a
        href={translatePath('/conversor-de-video-para-mp4')}
        class="px-2.5 xl:px-3 py-1.5 rounded-full hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100/90 dark:hover:bg-zinc-800/70 transition-all whitespace-nowrap"
      >
        MP4
      </a>

      <a
        href={translatePath('/conversor-de-audio')}
        class="px-2.5 xl:px-3 py-1.5 rounded-full hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100/90 dark:hover:bg-zinc-800/70 transition-all whitespace-nowrap"
      >
        {t('tools.filterAudio')}
      </a>

      <a
        href={translatePath('/compressor-de-video')}
        class="px-2.5 xl:px-3 py-1.5 rounded-full hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100/90 dark:hover:bg-zinc-800/70 transition-all whitespace-nowrap"
      >
        {t('header.compress')}
      </a>

      <a
        href={translatePath('/ferramentas')}
        class="hidden 2xl:inline-flex px-2.5 xl:px-3 py-1.5 rounded-full text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/50 font-semibold transition-all whitespace-nowrap"
      >
        {t('tools.filterAll')}
      </a>
    </nav>

    <!-- 3. Header Action Bar (Right - Precision Controls, Non-Wrapping) -->
    <div class="flex items-center gap-1 sm:gap-1.5 md:gap-2 shrink-0 whitespace-nowrap">
      <!-- Color Palette Switcher -->
      <PaletteSwitcher />

      <!-- Language Switcher Dropdown -->
      <LanguageSwitcher />

      <!-- Dark / Light Mode Slider (Desktop / Tablet) -->
      <div class="hidden sm:flex items-center shrink-0">
        <ThemeSlider />
      </div>

      <!-- Primary CTA: Convert Button -->
      <a
        href={translatePath('/conversor-de-video-para-mp4')}
        class="hidden xl:inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-full shadow-xs hover:shadow-md transition-all cursor-pointer shrink-0 whitespace-nowrap"
      >
        <span>{t('action.convert')}</span>
        <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Mobile Menu Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden p-2 rounded-full text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </header>
</div>

  <!-- 4. Mobile Slide-Over Sidebar Drawer -->
  <!-- Backdrop Overlay -->
  <div
    id="mobile-drawer-backdrop"
    class="mobile-backdrop"
    aria-hidden="true"
  ></div>

  <!-- Sidebar Drawer Panel -->
  <aside
    id="mobile-drawer"
    class="mobile-sidebar bg-white dark:bg-zinc-900 border-l border-zinc-200/80 dark:border-zinc-800 shadow-2xl flex flex-col"
    role="dialog"
    aria-modal="true"
    aria-label="Menu de Navegação"
  >
    <!-- Drawer Top Bar -->
    <div class="h-16 px-5 border-b border-zinc-200/80 dark:border-zinc-800 flex items-center justify-between shrink-0 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md">
      <a href={translatePath('/')} class="flex items-center gap-2.5 group select-none mobile-nav-link" aria-label="Conversor de Vídeo">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex items-center justify-center shadow-xs shadow-emerald-500/20 ring-1 ring-emerald-500/20">
          <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
        <span class="font-bold text-sm tracking-tight text-zinc-900 dark:text-white leading-none">
          Conversor<span class="text-emerald-600 dark:text-emerald-400">deVídeo</span>
        </span>
      </a>

      <button
        type="button"
        id="mobile-drawer-close"
        class="p-2 rounded-xl text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
        aria-label="Fechar menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Drawer Content (Scrollable) -->
    <div class="flex-1 overflow-y-auto px-5 py-5 space-y-6 scrollbar-thin">
      
      <!-- Primary Action CTA -->
      <a
        href={translatePath('/conversor-de-video-para-mp4')}
        class="flex items-center justify-between p-3.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-semibold text-xs sm:text-sm shadow-md shadow-emerald-600/20 active:scale-[0.98] transition-transform mobile-nav-link"
      >
        <span class="flex items-center gap-2">
          <span>⚡</span>
          <span>{t('action.convert')}</span>
        </span>
        <svg class="w-4 h-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Tools Directory Link -->
      <a
        href={translatePath('/ferramentas')}
        class="flex items-center justify-between p-3 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 border border-zinc-200/80 dark:border-zinc-700/80 text-zinc-800 dark:text-zinc-200 font-medium text-xs transition-colors mobile-nav-link"
      >
        <span class="flex items-center gap-2">
          <span>🧰</span>
          <span>{t('tools.metaTitle')}</span>
        </span>
        <span class="text-[11px] font-bold px-1.5 py-0.5 rounded-md bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
          36
        </span>
      </a>

      <!-- Quick Nav Hub Pills -->
      <div class="space-y-1.5">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 px-1">
          {t('header.formats')}
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <a href={translatePath('/conversor-de-video-para-mp4')} class="p-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-emerald-50 dark:hover:bg-zinc-800 font-medium text-zinc-800 dark:text-zinc-200 transition-colors mobile-nav-link">
            🎬 MP4
          </a>
          <a href={translatePath('/conversor-de-audio')} class="p-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-emerald-50 dark:hover:bg-zinc-800 font-medium text-zinc-800 dark:text-zinc-200 transition-colors mobile-nav-link">
            🎵 {t('tools.filterAudio')}
          </a>
          <a href={translatePath('/compressor-de-video')} class="p-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-emerald-50 dark:hover:bg-zinc-800 font-medium text-zinc-800 dark:text-zinc-200 transition-colors mobile-nav-link">
            🗜️ {t('header.compress')}
          </a>
          <a href={translatePath('/video-para-gif')} class="p-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-emerald-50 dark:hover:bg-zinc-800 font-medium text-zinc-800 dark:text-zinc-200 transition-colors mobile-nav-link">
            🎞️ GIF
          </a>
        </div>
      </div>

      <!-- Popular Tools List -->
      <div class="space-y-1.5">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 px-1 flex items-center gap-1.5">
          <span>⚡</span>
          <span>{t('header.colPopular')}</span>
        </div>
        <div class="space-y-1 text-xs">
          {popularTools.slice(0, 5).map((tItem) => (
            <a href={translatePath(tItem.href)} class="flex items-center justify-between p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium transition-colors mobile-nav-link">
              <span>{tItem.name}</span>
              <span class="text-[10px] text-zinc-400 dark:text-zinc-500">&rarr;</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Compression & Social -->
      <div class="space-y-1.5">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 px-1 flex items-center gap-1.5">
          <span>🗜️</span>
          <span>{t('header.colCompress')}</span>
        </div>
        <div class="space-y-1 text-xs">
          {compressorAndSocialTools.slice(0, 4).map((tItem) => (
            <a href={translatePath(tItem.href)} class="flex items-center justify-between p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium transition-colors mobile-nav-link">
              <span>{tItem.name}</span>
              <span class="text-[10px] text-zinc-400 dark:text-zinc-500">&rarr;</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Language & Theme Preferences Section -->
      <div class="pt-4 border-t border-zinc-200/80 dark:border-zinc-800 space-y-4">
        <!-- Color Palette Grid for Mobile -->
        <PaletteSwitcher isMobileCompact={true} />
        
        <div class="flex items-center justify-between p-3 rounded-xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200/80 dark:border-zinc-700/80">
          <span class="text-xs font-medium text-zinc-700 dark:text-zinc-300">Modo Escuro / Theme</span>
          <ThemeSlider />
        </div>
      </div>

    </div>

    <!-- Drawer Footer -->
    <div class="p-4 border-t border-zinc-200/80 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-950/50 flex flex-col gap-2 shrink-0">
      <div class="text-[11px] text-zinc-400 dark:text-zinc-500 font-medium flex items-center justify-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>{t('header.badge')}</span>
      </div>
      <div class="flex items-center justify-center gap-3 text-zinc-400 dark:text-zinc-500 text-[11px]">
        <a href={translatePath('/sobre')} class="hover:underline mobile-nav-link">{t('header.about')}</a>
        <span>•</span>
        <a href={translatePath('/privacidade')} class="hover:underline mobile-nav-link">{t('header.privacy')}</a>
        <span>•</span>
        <a href={translatePath('/termos')} class="hover:underline mobile-nav-link">{t('header.terms')}</a>
      </div>
    </div>
  </aside>

<style is:global>
  .mobile-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-backdrop.is-open {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .mobile-sidebar {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 320px;
    max-width: 86vw;
    z-index: 9999;
    transform: translateX(100%);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-sidebar.is-open {
    transform: translateX(0) !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
</style>

<script is:inline>
  (function() {
    function setupMobileDrawer() {
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const closeBtn = document.getElementById('mobile-drawer-close');
      const drawer = document.getElementById('mobile-drawer');
      const backdrop = document.getElementById('mobile-drawer-backdrop');
      const navLinks = document.querySelectorAll('.mobile-nav-link');

      if (!toggleBtn || !drawer || !backdrop) return;

      function openDrawer() {
        drawer.classList.add('is-open');
        backdrop.classList.add('is-open');
        toggleBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        drawer.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      function handleToggle(e) {
        e.preventDefault();
        e.stopPropagation();
        if (drawer.classList.contains('is-open')) {
          closeDrawer();
        } else {
          openDrawer();
        }
      }

      toggleBtn.addEventListener('click', handleToggle);
      closeBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        closeDrawer();
      });
      backdrop.addEventListener('click', (e) => {
        e.preventDefault();
        closeDrawer();
      });

      // Close drawer when any nav link is tapped
      navLinks.forEach((link) => {
        link.addEventListener('click', closeDrawer);
      });

      // Close on Escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
          closeDrawer();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupMobileDrawer);
    } else {
      setupMobileDrawer();
    }
  })();
</script>
