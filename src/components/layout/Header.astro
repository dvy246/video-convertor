---
import ThemeSlider from './ThemeSlider.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { 
  getLocalizedPopularTools, 
  getLocalizedCompressorTools, 
  getLocalizedCamcorderTools 
} from '../../i18n/navTools';
import type { SupportedLanguage } from '../../i18n/languages';

export interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

const popularTools = getLocalizedPopularTools(currentLang);
const compressorAndSocialTools = getLocalizedCompressorTools(currentLang);
const camcorderAndClassicTools = getLocalizedCamcorderTools(currentLang);
---

<header class="sticky top-0 z-50 w-full bg-white/90 dark:bg-zinc-950/90 backdrop-blur-xl border-b border-zinc-200/80 dark:border-zinc-800/80 shadow-xs transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3 sm:gap-6">
    
    <!-- 1. Logo & Brand Identity (Left) -->
    <a href={translatePath('/')} class="flex items-center gap-2.5 group shrink-0 select-none" aria-label="Conversor de Vídeo — Home">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex items-center justify-center shadow-md shadow-emerald-500/20 transition-all duration-300 group-hover:scale-105 group-hover:rotate-[-2deg]">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-black text-base tracking-tight text-zinc-900 dark:text-white leading-none group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
          Conversor<span class="text-emerald-600 dark:text-emerald-400">deVídeo</span>
        </span>
        <span class="text-[9px] text-zinc-500 dark:text-zinc-400 font-bold tracking-wider uppercase flex items-center gap-1 mt-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
          {t('header.badge')}
        </span>
      </div>
    </a>

    <!-- 2. Desktop Navigation (Center - Highly Efficient) -->
    <nav class="hidden lg:flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-zinc-600 dark:text-zinc-300" aria-label="Main Navigation">
      
      <!-- Mega Menu: Ferramentas & Formatos -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-zinc-700 dark:text-zinc-200 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-emerald-50/60 dark:hover:bg-emerald-950/40 transition-all font-extrabold cursor-pointer border border-transparent hover:border-emerald-200/60 dark:hover:border-emerald-800/60"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>{t('header.formats')}</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded-md bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 font-black">
            51
          </span>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5">
            <path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Mega Menu Panel -->
        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2 w-[740px] pointer-events-none group-hover:pointer-events-auto">
          <div class="bg-white/95 dark:bg-zinc-900/95 backdrop-blur-xl border border-zinc-200/90 dark:border-zinc-800 rounded-2xl p-5 shadow-2xl shadow-zinc-950/15 grid grid-cols-3 gap-5 text-left">
            
            <!-- Column 1: Popular & Audio -->
            <div class="space-y-2.5">
              <div class="text-[10px] font-black uppercase tracking-wider text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/80 px-2.5 py-1 rounded-lg inline-flex items-center gap-1 border border-emerald-200/60 dark:border-emerald-800/60">
                <span>⚡</span>
                <span>{t('header.colPopular')}</span>
              </div>
              <ul class="space-y-1">
                {popularTools.map((tItem) => (
                  <li>
                    <a href={translatePath(tItem.href)} class="block p-1.5 rounded-lg hover:bg-emerald-50/50 dark:hover:bg-zinc-800/80 transition-colors group/item">
                      <div class="text-xs font-bold text-zinc-900 dark:text-zinc-100 group-hover/item:text-emerald-600 dark:group-hover/item:text-emerald-400">
                        {tItem.name}
                      </div>
                      <div class="text-[11px] text-zinc-400 dark:text-zinc-500 leading-tight truncate">
                        {tItem.desc}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Column 2: Compressors & Social -->
            <div class="space-y-2.5">
              <div class="text-[10px] font-black uppercase tracking-wider text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-1 rounded-lg inline-flex items-center gap-1 border border-zinc-200 dark:border-zinc-700">
                <span>🗜️</span>
                <span>{t('header.colCompress')}</span>
              </div>
              <ul class="space-y-1">
                {compressorAndSocialTools.map((tItem) => (
                  <li>
                    <a href={translatePath(tItem.href)} class="block p-1.5 rounded-lg hover:bg-emerald-50/50 dark:hover:bg-zinc-800/80 transition-colors group/item">
                      <div class="text-xs font-bold text-zinc-900 dark:text-zinc-100 group-hover/item:text-emerald-600 dark:group-hover/item:text-emerald-400">
                        {tItem.name}
                      </div>
                      <div class="text-[11px] text-zinc-400 dark:text-zinc-500 leading-tight truncate">
                        {tItem.desc}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Column 3: Camcorders & Classic -->
            <div class="space-y-2.5">
              <div class="text-[10px] font-black uppercase tracking-wider text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-1 rounded-lg inline-flex items-center gap-1 border border-zinc-200 dark:border-zinc-700">
                <span>📹</span>
                <span>{t('header.colCamcorders')}</span>
              </div>
              <ul class="space-y-1">
                {camcorderAndClassicTools.slice(0, 5).map((tItem) => (
                  <li>
                    <a href={translatePath(tItem.href)} class="block p-1.5 rounded-lg hover:bg-emerald-50/50 dark:hover:bg-zinc-800/80 transition-colors group/item">
                      <div class="text-xs font-bold text-zinc-900 dark:text-zinc-100 group-hover/item:text-emerald-600 dark:group-hover/item:text-emerald-400">
                        {tItem.name}
                      </div>
                      <div class="text-[11px] text-zinc-400 dark:text-zinc-500 leading-tight truncate">
                        {tItem.desc}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Bottom Row: View All 51 Tools -->
            <div class="col-span-3 pt-3 mt-1 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
              <span class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">
                Processamento Local • Sem Upload
              </span>
              <a href={translatePath('/ferramentas')} class="inline-flex items-center gap-1.5 text-xs font-black text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:underline">
                <span>{t('header.allFormats')}</span>
              </a>
            </div>

          </div>
        </div>
      </div>

      <!-- Quick Nav Hub Links -->
      <a
        href={translatePath('/conversor-de-video-para-mp4')}
        class="px-3 py-2 rounded-xl hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100/80 dark:hover:bg-zinc-800/80 transition-colors"
      >
        MP4
      </a>

      <a
        href={translatePath('/conversor-de-audio')}
        class="px-3 py-2 rounded-xl hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100/80 dark:hover:bg-zinc-800/80 transition-colors"
      >
        Áudio & MP3
      </a>

      <a
        href={translatePath('/compressor-de-video')}
        class="px-3 py-2 rounded-xl hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100/80 dark:hover:bg-zinc-800/80 transition-colors"
      >
        {t('header.compress')}
      </a>

      <a
        href={translatePath('/ferramentas')}
        class="px-3 py-2 rounded-xl text-emerald-700 dark:text-emerald-400 hover:text-emerald-900 dark:hover:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/60 transition-colors"
      >
        {t('tools.filterAll')}
      </a>
    </nav>

    <!-- 3. Header Action Bar (Right - Precision Controls) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Language Switcher Dropdown -->
      <LanguageSwitcher />

      <!-- Dark / Light Mode Slider -->
      <div class="flex items-center">
        <ThemeSlider />
      </div>

      <!-- Primary CTA: Convert Button -->
      <a
        href={translatePath('/conversor-de-video-para-mp4')}
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white px-4 py-2 rounded-xl shadow-md shadow-emerald-600/20 hover:shadow-lg hover:shadow-emerald-600/30 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
      >
        <span>{t('action.convert')}</span>
        <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path strokeLinecap="round" strokeLinejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Mobile Menu Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden p-2 rounded-xl text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
          <path strokeLinecap="round" strokeLinejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 4. Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-xl px-4 py-6 space-y-6 max-h-[80vh] overflow-y-auto transition-colors duration-200">
    
    <!-- Directory CTA Bar -->
    <a href={translatePath('/ferramentas')} class="flex items-center justify-between p-3.5 rounded-2xl bg-gradient-to-r from-emerald-500/15 via-teal-500/10 to-transparent border border-emerald-500/30 text-emerald-800 dark:text-emerald-300 font-extrabold text-xs uppercase tracking-wider">
      <span class="flex items-center gap-2">
        <span>🧰</span>
        <span>{t('tools.metaTitle')}</span>
      </span>
      <span>&rarr;</span>
    </a>

    <div class="space-y-2">
      <div class="text-xs font-black uppercase tracking-wider text-emerald-800 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2.5 py-1 rounded-lg">
        {t('header.colPopular')}
      </div>
      <div class="grid grid-cols-2 gap-2 text-xs">
        {popularTools.map((tItem) => (
          <a href={translatePath(tItem.href)} class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/70 hover:bg-emerald-50 dark:hover:bg-zinc-800 font-semibold text-zinc-800 dark:text-zinc-200 transition-colors">
            {tItem.name}
          </a>
        ))}
      </div>
    </div>

    <div class="space-y-2">
      <div class="text-xs font-black uppercase tracking-wider text-zinc-800 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-1 rounded-lg">
        {t('header.colCompress')}
      </div>
      <div class="grid grid-cols-2 gap-2 text-xs">
        {compressorAndSocialTools.map((tItem) => (
          <a href={translatePath(tItem.href)} class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/70 hover:bg-emerald-50 dark:hover:bg-zinc-800 font-semibold text-zinc-800 dark:text-zinc-200 transition-colors">
            {tItem.name}
          </a>
        ))}
      </div>
    </div>

    <div class="space-y-2">
      <div class="text-xs font-black uppercase tracking-wider text-zinc-800 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-1 rounded-lg">
        {t('header.colCamcorders')}
      </div>
      <div class="grid grid-cols-2 gap-2 text-xs">
        {camcorderAndClassicTools.slice(0, 6).map((tItem) => (
          <a href={translatePath(tItem.href)} class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/70 hover:bg-emerald-50 dark:hover:bg-zinc-800 font-semibold text-zinc-800 dark:text-zinc-200 transition-colors">
            {tItem.name}
          </a>
        ))}
      </div>
    </div>

    <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800 flex flex-col gap-2 text-xs font-bold">
      <a href={translatePath('/ferramentas')} class="p-3 rounded-xl bg-emerald-600 text-white text-center shadow-xs">
        {t('header.allFormats')}
      </a>
      <div class="flex items-center justify-center gap-4 text-zinc-500 dark:text-zinc-400 pt-2 text-[11px]">
        <a href={translatePath('/sobre')} class="hover:underline">{t('header.about')}</a>
        <span>•</span>
        <a href={translatePath('/privacidade')} class="hover:underline">{t('header.privacy')}</a>
        <span>•</span>
        <a href={translatePath('/termos')} class="hover:underline">{t('header.terms')}</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
