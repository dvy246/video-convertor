---
// ThemeSlider.astro - Accessible, smooth Dark/Light mode toggle slider
---

<button
  type="button"
  id="theme-toggle-slider"
  class="relative inline-flex items-center h-7.5 w-13 rounded-full p-0.5 bg-zinc-200/80 dark:bg-zinc-800 border border-zinc-300/60 dark:border-zinc-700/60 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 cursor-pointer shadow-2xs"
  role="switch"
  aria-checked="true"
  aria-label="Alternar entre modo claro e modo escuro"
  title="Alternar modo claro / escuro"
>
  <!-- Background Icons (Sun on Left, Moon on Right) -->
  <span class="absolute inset-0 flex items-center justify-between px-1.5 text-[10px] pointer-events-none select-none">
    <span class="text-amber-500 transition-opacity duration-200 dark:opacity-30">
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="12" y1="21" x2="12" y2="23" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="1" y1="12" x2="3" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="21" y1="12" x2="23" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </span>
    <span class="text-indigo-400 transition-opacity duration-200 opacity-30 dark:opacity-100">
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </span>
  </span>

  <!-- Sliding Knob -->
  <span
    id="theme-slider-knob"
    class="relative z-10 w-6 h-6 rounded-full bg-white dark:bg-zinc-950 shadow-xs border border-zinc-200/80 dark:border-zinc-800 flex items-center justify-center transform transition-transform duration-200 ease-out translate-x-0 dark:translate-x-5.5"
  >
    <!-- Sun Icon on Knob (visible in Light Mode) -->
    <svg class="w-3 h-3 text-amber-500 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4" fill="currentColor" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </svg>
    <!-- Moon Icon on Knob (visible in Dark Mode) -->
    <svg class="w-3 h-3 text-indigo-400 hidden dark:block" viewBox="0 0 24 24" fill="currentColor">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </span>
</button>

<script is:inline>
  (function() {
    function initThemeSlider() {
      const toggle = document.getElementById('theme-toggle-slider');
      if (!toggle) return;

      const isDark = document.documentElement.classList.contains('dark');
      toggle.setAttribute('aria-checked', String(isDark));

      toggle.onclick = function() {
        const currentlyDark = document.documentElement.classList.contains('dark');
        if (currentlyDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
          toggle.setAttribute('aria-checked', 'false');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
          toggle.setAttribute('aria-checked', 'true');
        }
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { isDark: !currentlyDark } }));
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initThemeSlider);
    } else {
      initThemeSlider();
    }
  })();
</script>
