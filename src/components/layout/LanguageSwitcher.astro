---
import { languages, type SupportedLanguage } from '../../i18n/languages';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);
const currentPath = Astro.url.pathname;
const currentLangInfo = languages[currentLang];
---

<div class="relative group/lang inline-block text-left" id="lang-switcher">
  <button
    type="button"
    aria-label="Selecionar idioma / Change language"
    aria-haspopup="true"
    aria-expanded="false"
    class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 hover:border-emerald-500/60 dark:hover:border-emerald-500/60 transition-all text-xs font-semibold shadow-xs"
  >
    <span class="text-sm leading-none" aria-hidden="true">{currentLangInfo.flag}</span>
    <span class="hidden sm:inline font-bold">{currentLangInfo.name}</span>
    <span class="sm:hidden font-bold uppercase text-[11px]">{currentLang}</span>
    <svg class="w-3.5 h-3.5 text-zinc-400 group-hover/lang:text-emerald-500 transition-transform group-hover/lang:rotate-180 duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div class="absolute right-0 mt-1.5 w-44 rounded-xl bg-white dark:bg-zinc-800 border border-zinc-200/80 dark:border-zinc-700 shadow-xl opacity-0 invisible group-hover/lang:opacity-100 group-hover/lang:visible group-focus-within/lang:opacity-100 group-focus-within/lang:visible transition-all duration-150 z-50 py-1.5 divide-y divide-zinc-100 dark:divide-zinc-700/50">
    <div class="px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-wider text-zinc-600 dark:text-zinc-300">
      Idiomas / Languages
    </div>
    <div class="py-1">
      {(Object.entries(languages) as [SupportedLanguage, typeof languages[SupportedLanguage]][]).map(([code, info]) => {
        const isCurrent = code === currentLang;
        const targetUrl = translatePath(currentPath, code);
        return (
          <a
            href={targetUrl}
            class={`flex items-center justify-between px-3 py-2 text-xs font-medium transition-colors ${
              isCurrent
                ? 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-bold'
                : 'text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-700/60 hover:text-emerald-600 dark:hover:text-emerald-400'
            }`}
            hreflang={info.code}
          >
            <div class="flex items-center gap-2">
              <span class="text-sm leading-none" aria-hidden="true">{info.flag}</span>
              <span>{info.name}</span>
            </div>
            {isCurrent && (
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true" />
            )}
          </a>
        );
      })}
    </div>
  </div>
</div>
