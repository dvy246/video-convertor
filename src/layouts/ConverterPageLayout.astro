---
import BaseLayout from './BaseLayout.astro';
import { ConverterApp } from '../components/converter/ConverterApp';
import HowItWorks from '../components/sections/HowItWorks.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import FormatGrid from '../components/sections/FormatGrid.astro';
import type { FormatPageData } from '../data/formatPages';
import { 
  generateWebApplicationSchema, 
  generateHowToSchema, 
  generateFAQSchema, 
  generateBreadcrumbSchema,
  generateOrganizationSchema
} from '../lib/seo/schema';

export interface Props {
  data: FormatPageData;
}

const { data } = Astro.props;
const canonicalUrl = `https://conversordevideo.com/${data.slug}`;

const orgSchema = generateOrganizationSchema();

const webAppSchema = generateWebApplicationSchema({
  name: `${data.h1Prefix} ${data.h1Highlight}`,
  description: data.metaDescription,
  url: canonicalUrl
});

const howToSchema = generateHowToSchema({
  name: `Como ${data.h1Prefix.toLowerCase()} ${data.h1Highlight.toLowerCase()} online`,
  description: data.heroSubtitle,
  steps: [
    {
      position: 1,
      name: 'Selecione o arquivo de vídeo',
      text: 'Arraste o vídeo para a área de conversão ou clique para selecionar do seu dispositivo.'
    },
    {
      position: 2,
      name: 'Escolha a predefinição',
      text: 'O formato desejado já vem configurado com a taxa de bits ideal.'
    },
    {
      position: 3,
      name: 'Baixe o arquivo convertido',
      text: 'Clique em Converter e baixe seu arquivo imediatamente sem marcas d’água.'
    }
  ]
});

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Início', url: 'https://conversordevideo.com' },
  { name: `${data.h1Prefix} ${data.h1Highlight}`, url: canonicalUrl }
]);

const faqSchema = generateFAQSchema(data.faqs);
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  canonicalUrl={canonicalUrl}
  keywords={data.keywords}
  schemas={[orgSchema, webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class="pt-8 pb-12 sm:pt-14 sm:pb-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center space-y-4 mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 text-xs font-bold uppercase tracking-wider border border-emerald-200/80 dark:border-emerald-800/60">
        {data.badge}
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-zinc-900 dark:text-white tracking-tight leading-tight">
        {data.h1Prefix} <span class="text-emerald-600 dark:text-emerald-400">{data.h1Highlight}</span> {data.h1Suffix}
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        {data.heroSubtitle}
      </p>
    </div>

    <!-- Converter Island -->
    <ConverterApp 
      initialTargetFormat={data.targetFormat}
      initialPreset={data.initialPreset}
      defaultTitle={data.dropzoneTitle}
      client:idle 
    />
  </section>

  <!-- How It Works Section -->
  <HowItWorks 
    title={`Como ${data.h1Prefix.toLowerCase()} ${data.h1Highlight.toLowerCase()} em segundos`}
    subtitle="Sem filas de espera, sem necessidade de cadastro e 100% no seu navegador."
  />

  <!-- Technical Explainer Section -->
  <section class="py-12 sm:py-16 bg-white dark:bg-zinc-900 border-y border-zinc-200/80 dark:border-zinc-800 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8 text-zinc-700 dark:text-zinc-300">
      <div class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
          {data.explainerTitle}
        </h2>
        {data.explainerParagraphs.map((p) => (
          <p class="text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
            {p}
          </p>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
        <div class="bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80 rounded-2xl p-6 space-y-3">
          <h3 class="font-bold text-base text-zinc-900 dark:text-white">
            {data.sourceDetailsTitle}
          </h3>
          <ul class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 space-y-2 list-disc pl-4">
            {data.sourceDetails.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <div class="bg-emerald-50/50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 rounded-2xl p-6 space-y-3">
          <h3 class="font-bold text-base text-emerald-950 dark:text-emerald-300">
            {data.targetDetailsTitle}
          </h3>
          <ul class="text-xs sm:text-sm text-emerald-900 dark:text-emerald-400 space-y-2 list-disc pl-4">
            {data.targetDetails.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Format Grid Tools -->
  <FormatGrid />

  <!-- FAQ Section -->
  <FAQSection faqs={data.faqs} />
</BaseLayout>
